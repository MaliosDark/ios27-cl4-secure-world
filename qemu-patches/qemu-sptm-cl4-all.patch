+            }
+        }
+        struct dtree_node *chosen = adt_find_node((struct dtree_node*)dtree, "chosen");
+        if (chosen) {
+            u32 *scale = adt_get_prop_val(chosen, "display-scale");
+            if (scale && *scale == 0) *scale = 1;
+        }
+        fflush(stdout);
+    }
